# Fixture for validating the NATIVE (plain Linux, e.g. Mageia) branch of
# docker-compose.yml without being on that boot. Values are what
# rocm-detect.sh emits when it finds /dev/kfd + /dev/dri and no host ROCm.
# Not used at runtime -- tools/server/tests/ only.
PROJECT_DIR=/data/disk/home/arunasp/stuff/LocusAI
TARGET_UID=1000
TARGET_GID=1000
COMPOSE_PROFILES=rocm-image
ROCM_SOURCE=image
ROCM_IMAGE=rocm/dev-ubuntu-24.04:7.14.0-full
ROCM_MOUNT_SRC=rocm-sdk
WSL_LIB_SRC=wsl-lib-unused
ROCM_LIB_PATH=/opt/rocm/lib
ROCM_BIN_PATH=/opt/rocm/bin
GPU_DEV_1=/dev/kfd
GPU_DEV_2=/dev/dri
