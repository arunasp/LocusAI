# Windows Zone.Identifier alternate-data-stream metadata (created when
# downloading files via a browser)
*:Zone.Identifier

# Python
__pycache__/
*.pyc

# Local env overrides, if any ever get created by hand
.env

# Built Desktop extension bundle -- regenerate via
# tools/desktop-extension: npx --yes @anthropic-ai/mcpb pack . dist/...
tools/desktop-extension/dist/*.mcpb

# Runtime debug trace written by tools/desktop-extension/index.js,
# next to itself rather than a per-user temp/AppData path -- see the
# comment in index.js for why.
tools/desktop-extension/debug.log

# core/ build products and dev environment. build/ holds the compiled
# liblocus.so and the C test binary; .venv is the project-local
# virtualenv core/Makefile's .deps target creates (matching
# cicd_runner's own ensure_venv pattern), and .deps is that target's
# sentinel file. All three are regenerated by `make -C core all`.
core/build/
core/.venv/
core/.deps

# Extracted HIP SDK headers, created by unpacking amdrocm-runtime-dev7.14's
# .deb into core/gpu/.rocm-include and picked up by core/Makefile's HIPINC
# only when present. NOT tracked, for two reasons: it is a redistribution of
# AMD's SDK, and it is version-pinned to whatever ROCm the host currently
# runs -- committing it would silently skew against the host's libraries
# after the next ROCm move. Regenerate rather than restore; see
# doc/core/HARDWARE.md.
core/gpu/.rocm-include/

# Transfer payloads. The standing scheme (LZMA2-raw + base85/RFC1924) writes
# a .b85 blob and DELETES it once both digests verify, so any surviving one
# is the residue of a FAILED transfer -- deliberately preserved for
# diagnosis, and never something to commit.
*.b85

# cicd/ transfer artefacts. payload.b64 is a generated transport blob and
# wheels/ is a resolved dependency cache -- both are regenerated by
# `make pack` and `make wheels`. cicd/transfer.py itself IS tracked.
cicd/payload.b64
cicd/wheels/

# npm dependencies for the desktop extension (currently just
# mcp-remote, bundled into the .mcpb rather than fetched via npx at
# launch -- see index.js). package.json and the generated
# package-lock.json ARE committed; only the installed tree isn't.
tools/desktop-extension/node_modules/

# CI/CD and host-session scratch. logs/ IS the expected place for this
# (pipeline output, ad hoc host-tool drops like a stale Claude Code
# changelog.md copy or a project-directory backup) -- it's the
# directory itself that's intentional, never its contents. Ignored
# wholesale rather than picking specific patterns: this has already
# caught a real Claude Code session transcript
# (~/.claude/projects/.../*.jsonl, left behind by a Remote
# Control/GUI-SSH session running directly on the WSL2 host, entirely
# outside this repo's Docker container and its allowlist -- a
# different, unrestricted access path from tools/server's LocusAI
# Local Bash proxy) and a broken/empty backup tarball, 2026-08-07.
# Neither should ever reach a commit.
logs/

# Commit messages staged for `make commit-verified`. In the tree and
# ignored, rather than hidden inside .git/ -- which is undeclared and
# breaks in a worktree, where .git is a file.
/.locus/
